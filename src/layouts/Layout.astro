---
interface Props {
  title: string
  // Absolute URL of the page. Astro.url carries the environment's https
  // domain behind the gateway; see security.allowedDomains in astro.config.mjs.
  canonical?: string
}

const { title, canonical } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
    color: #0f172a;
    background: #f8fafc;
  }

  body {
    margin: 0;
  }

  main {
    max-width: 42rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }

  code {
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    background: #e2e8f0;
  }

  button,
  input {
    font: inherit;
  }
</style>
